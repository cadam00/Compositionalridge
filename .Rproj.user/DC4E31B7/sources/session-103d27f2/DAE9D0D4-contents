kld.ridge <- function(y, x, lambda = NULL, nlambda = 100, xnew = NULL) {

  runtime <- proc.time()
  ridge <- glmnet::glmnet(x, y, alpha = 0, nlambda = nlambda, lambda = lambda, family = "multinomial",
                        type.multinomial = "ungrouped", standardize = FALSE)
  lambda <- ridge$lambda
  nlambda <- length(lambda)

  if ( is.null( colnames(x) ) ) {
    p <- dim(x)[2]
    nama <- c("constant", paste("X", 1:p, sep = "") )
  } else  nama <- c("constant", colnames(x) )
  colnames(x) <- nama[-1]

  D <- dim(y)[2]
  be <- list()
  beta <- coef(ridge)
  for ( i in 1:nlambda ) {
    ini <- beta[[ 1 ]][, i]
    for ( j in 2:D )  ini <- cbind(ini, beta[[ j ]][, i])
    be[[ i ]] <- ini
    colnames(be[[ i ]]) <- paste0("Y", 2:D)
  }
  names(be) <- paste("lambda=", lambda, sep="")

  est <- predict( ridge, newx = x, type = "response" )
  info <- cbind(lambda, 0)
  for ( i in 1:nlambda ) {
    kl <- y * log(y / est[, , i])
    kl[ is.infinite(kl) ] <- NA
    info[i, 2] <- sum(kl, na.rm = TRUE)
  }
  colnames(info) <- c("lambda", "KLD")

  est <- NULL
  if ( !is.null(xnew) ) {
    est <- list()
    mu <- predict(ridge, newx = xnew, type = "response")
    for ( i in 1:nlambda )  est[[ i ]] <- mu[, , i]
    names(est) <- paste("lambda=",lambda,sep="")
  }
  mu <- NULL

  runtime <- proc.time() - runtime

  list(runtime = runtime, info = info, be = be, est = est)
}
