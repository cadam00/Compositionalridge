cv.aregridge <- function(y, x, a = seq(0.1, by = 0.1), lambda = NULL, nlambda = 100, nfolds = 10,
                        folds = NULL, seed = NULL) {

  runtime <- proc.time()
  if ( min(y) == 0 )  a <- a[a > 0]
  la <- length(a)
  n <- dim(y)[1]
  if ( is.null(folds) )  {
    poia <- unique( which( y == 0, arr.ind = TRUE)[, 1] )
    if ( length(poia) > nfolds ) {
      id <- numeric(n)   ;   id[poia] <- 1   ;   id <- id + 1
      folds <- Compositional::makefolds(id, nfolds = nfolds, seed = seed, stratified = TRUE)
    } else  folds <- Compositional::makefolds(1:n, nfolds = nfolds, seed = seed, stratified = FALSE)
  }
  nfolds <- length(folds)
  perf <- mod <- list()
  lopt <- numeric(la)

  for ( i in 1:la ) {
    yb <- Compositional::alfa(y, a[i])$aff
    mod[[ i ]] <- areg.ridge(y, x, a = a[i], lambda = lambda, nlambda = nlambda, yb = yb)
    lambda <- mod[[ i ]]$info[, 1]
    nlambda <- length(lambda)
    kld <- matrix(nrow = nfolds, ncol = nlambda )

    for ( k in 1:nfolds ) {
      xtest <- x[ folds[[ k ]], ]
      xtrain <- x[ -folds[[ k ]], ]
      ytest <- y[ folds[[ k ]], ]
      ytrain <- y[ -folds[[ k ]], ]
      ybtrain <- yb[ -folds[[ k ]], ]
      est <- areg.ridge(y = ytrain, x = xtrain, a = a[i], lambda = lambda, nlambda = nlambda, yb = ybtrain, xnew = xtest)$est
      for ( j in 1: length(est) ) {
        kl <- ytest * log(ytest / est[[ j ]] )
        kl[is.infinite(kl)] <- NA
        kld[k, j] <- sum(kl, na.rm = TRUE)
      }
    }

    kld <- cbind( lambda, colMeans(kld, na.rm = TRUE) )
    colnames(kld) <- c("lambda", "KLD")
    lopt[i] <- which.min(kld[, 2])
    perf[[ i ]] <- kld
  }
  runtime <- proc.time() - runtime

  list(runtime = runtime, kld = kld, lambda.opt = lambda[lopt], be = mod$be[[ lopt ]] )
}


