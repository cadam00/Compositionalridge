cv.zadrridge <- function(y, x, lambda = NULL, nlambda = 100, tol = 1e-06, maxit = 100,
                         folds = NULL, nfolds = 10, seed = NULL) {
  n <- dim(y)[1]
  if ( is.null(folds) )  {
    poia <- unique( which( y == 0, arr.ind = TRUE)[, 1] )
    if ( length(poia) > nfolds ) {
      id <- numeric(n)   ;   id[poia] <- 1   ;   id <- id + 1
      folds <- Compositional::makefolds(id, nfolds = nfolds, seed = seed, stratified = TRUE)
    } else  folds <- Compositional::makefolds(1:n, nfolds = nfolds, seed = seed, stratified = FALSE)
  }
  nfolds <- length(folds)
  lamkld <- list()

  mod <- zadr.ridge(y = y, x = x, lambda = lambda, nlambda = nlambda, tol = tol, maxit = maxit)
  lambda <- mod$info[, 1]
  nlambda <- length(lambda)
  kld <- matrix(nrow = nfolds, ncol = nlambda )

  for ( k in 1:nfolds ) {
    xtest <- x[ folds[[ k ]], ]
    xtrain <- x[ -folds[[ k ]], ]
    ytest <- y[ folds[[ k ]], ]
    ytrain <- y[ -folds[[ k ]], ]
    est <- zadr.ridge(y = ytrain, x = xtrain, lambda = lambda, nlambda = nlambda, xnew = xtest, tol = tol, maxit = maxit)$est
    for ( j in 1: length(est) ) {
      kl <- ytest * log(ytest / est[[ j ]] )
      kl[is.infinite(kl)] <- NA
      kld[k, j] <- sum(kl, na.rm = TRUE)
    }
  }
  kld <- cbind( lambda, colMeans(kld, na.rm = TRUE) )
  colnames(kld) <- c("lambda", "KLD")
  lopt <- which.min(kld[, 2])
  list(kld = kld, lambda.opt = lambda[lopt], be = mod$be[[ lopt ]], phi = mod$info[lopt, 3] )
}

