install.packages("roxygen2")
x <- matrix( rnorm(150 * 10), ncol = 10 )
y <- as.matrix(iris[, 1:3])
y <- y / rowSums(y)
ind <- sample(150, 10)
for ( k in ind )  y[k, sample(3, 1)] <- 0
y <- y / rowSums(y)
mod <- kld.ridge(y, x)
mod2=cv.zadrridge(y,x)
cv.zadrridge(y,x)
zadr.ridge(y,x)
lambda = NULL
maxit = 100
tol = 1e-6
xnew = NULL
nlambda = 100
runtime <- proc.time()
n <- dim(y)[1]   ;  D <- dim(y)[2]  ;  p <- D - 1
x <- as.matrix(x)
K <- dim(x)[2] + 1
nam <- colnames(x)
if ( !is.null(nam) ) {
nam <- c( "Intercept", nam )
} else   nam <- c( "Intercept", paste("X", 1:(K - 1), sep = "" ) )
m <- Rfast::colmeans(x)
s <- Rfast::colVars(x, std = TRUE)
x <- t( ( t(x) - m ) / s )
x <- cbind(1, x)
logy <- log(y)
txi <- list()
for ( i in 1:n )  txi[[ i ]] <- tcrossprod(x[i, ])
pen <- rep(1, K)
pen[1] <- 0
mod <- kld.ridge(y, x[, -1], lambda = lambda, nlambda = nlambda)
lambda <- mod$info[, 1]
nlambda <- length(lambda)
ini <- mod$be
pos <- y > 0
a1 <- which( Rfast::rowsums( pos ) == D )
a2 <- which( Rfast::rowsums( pos ) != D )
n1 <- length(a1)   ;   n2 <- n - n1
if ( n2 > 0 ) {
za <- y[a2, , drop = FALSE]
za[za == 0] <- 1  ;  za[za < 1] <- 0
theta <- as.vector( table( apply(za, 1, paste, collapse = ",") ) )
const <- n1 * log(n1 / n) + sum( theta * log(theta / n) )
} else  const <- n1 * log(n1 / n)
Pidx <- lapply( 1:n, function(i)  which( pos[i, ] ) )
be <- list()   ;   loglik_pen <- phi <- numeric(nlambda)
beta <- ini[[ 1 ]][, -1] - ini[[ 1 ]][, 1]
lambda
for ( vim in 1:nlambda ) {
mod <- zpath(beta, phi, logy, y, x, txi, Pidx, lambda[vim], n, D, p, K, pen, maxit, tol)
beta <- mod$be
colnames(beta) <- paste0("Y", 2:D)
rownames(beta) <- nam
be[[ vim ]] <- beta
phi[vim] <-  mod$phi
loglik_pen[vim] <- mod$loglik_pen + const
}
zpath <- function(beta, phi, logy, y, x, txi, Pidx, lambda, n, D, p, K, pen, maxit, tol) {
.Call(`_Compositionalridge_zpath`, beta, phi, logy, y, x, txi, Pidx, lambda, n, D, p, K, pen, maxit, tol)
}
for ( vim in 1:nlambda ) {
mod <- zpath(beta, phi, logy, y, x, txi, Pidx, lambda[vim], n, D, p, K, pen, maxit, tol)
beta <- mod$be
colnames(beta) <- paste0("Y", 2:D)
rownames(beta) <- nam
be[[ vim ]] <- beta
phi[vim] <-  mod$phi
loglik_pen[vim] <- mod$loglik_pen + const
}
zadr.ridge(y,x)
